{
  "name": "wohnung-scout-bot",
  "version": "1.0.0",
  "description": "Privater Discord-Assistent für offiziell empfangene Wohnungs-Suchaufträge",
  "main": "build/src/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/src/index.js",
    "dev": "node --watch --import tsx src/index.ts",
    "preview": "node --import tsx src/preview.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit && node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "imapflow": "^1.0.181",
    "mailparser": "^3.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
