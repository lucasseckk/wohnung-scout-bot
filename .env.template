DISCORD_TOKEN=YOUR_DISCORD_TOKEN
DISCORD_CHANNEL_ID=YOUR_DISCORD_CHANNEL_ID
DISCORD_PING_ROLE_ID=
DISCORD_PING_ROLE_NAME=
# Erforderlich. Reihenfolge entspricht Hauptprofil, zweitem Bewerberprofil usw.
# Mehrere Discord-Nutzer-IDs mit Kommas trennen; keine Leerzeichen erforderlich.
DISCORD_ALLOWED_USER_IDS=

# Pfad zum persönlichen, nicht eingecheckten Suchprofil
PROFILE_PATH=./config/profile.json
DATABASE_PATH=./data/wohnungen.sqlite
POLL_INTERVAL_MINUTES=10
NOTIFY_EXISTING_ON_START=false
RETENTION_DAYS=30

# Offizieller ImmoScout-Suchauftrag per E-Mail (IMAP/App-Passwort)
# Gmail: imap.gmail.com; andere Anbieter entsprechend deren IMAP-Dokumentation
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=wohnungssuche@example.com
IMAP_PASSWORD=YOUR_IMAP_APP_PASSWORD
IMAP_MAILBOX=INBOX
IMAP_LOOKBACK_HOURS=72
IMAP_MAX_MESSAGES=100
IMAP_SENDER_CONTAINS=immobilienscout24
IMAP_SUBJECT_CONTAINS=Angebot
